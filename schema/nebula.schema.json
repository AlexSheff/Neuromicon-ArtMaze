{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuromicon.artmaze/schema/nebula.schema.json",
  "title": "Neuromicon Artmaze Astronomical Nebula & Sky Registry Schema",
  "type": "object",
  "required": ["version", "allowedLicenses", "nebulae"],
  "properties": {
    "version": { "type": "string" },
    "allowedLicenses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["PD-NASA", "CC0-1.0", "CC-BY-4.0"]
      }
    },
    "nebulae": {
      "type": "array",
      "minItems": 24,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "image",
          "preview",
          "nativeSize",
          "credit",
          "license",
          "licenseUrl",
          "sourceUrl",
          "retrievedAt",
          "licenseVerifiedBy",
          "sha256",
          "processing",
          "palette",
          "dominantHue",
          "tone"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^NEB_[0-9]{4}$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "emission",
              "reflection",
              "planetary",
              "supernova-remnant",
              "dark-molecular",
              "deep-field"
            ]
          },
          "image": { "type": "string", "minLength": 1 },
          "preview": { "type": "string", "minLength": 1 },
          "remoteImageUrl": { "type": "string" },
          "nativeSize": {
            "type": "array",
            "items": { "type": "integer", "minimum": 256 },
            "minItems": 2,
            "maxItems": 2
          },
          "credit": { "type": "string", "minLength": 3 },
          "license": {
            "type": "string",
            "enum": ["PD-NASA", "CC0-1.0", "CC-BY-4.0"]
          },
          "licenseUrl": { "type": "string", "pattern": "^https://" },
          "sourceUrl": { "type": "string", "pattern": "^https://" },
          "retrievedAt": { "type": "string", "pattern": "^2026-[0-9]{2}-[0-9]{2}$" },
          "licenseVerifiedBy": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "processing": { "type": "string", "minLength": 1 },
          "palette": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          },
          "dominantHue": { "type": "number", "minimum": 0, "maximum": 360 },
          "tone": { "type": "string", "enum": ["warm", "cool"] }
        }
      }
    }
  }
}
