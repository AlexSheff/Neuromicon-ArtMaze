{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neuromicon.artmaze/schema/room.schema.json",
  "title": "Neuromicon ArtMaze Room Manifest",
  "description": "Authoritative schema for ROOM_SPEC.md v1.0 room.json packages",
  "type": "object",
  "required": ["specVersion", "id", "version", "title", "author", "type", "environment", "doors"],
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^ROOM_[0-9]{4}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "titleRu": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "descriptionRu": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["standard", "procedural", "custom", "empty", "void"]
    },
    "environment": {
      "type": "object",
      "properties": {
        "scene": { "type": "string" },
        "scale": { "type": "number", "minimum": 0.1 },
        "dimensions": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "palette": {
          "type": "object",
          "properties": {
            "wall": { "type": "string" },
            "floor": { "type": "string" },
            "ceiling": { "type": "string" },
            "fog": { "type": "string" },
            "accent": { "type": "string" }
          }
        },
        "spawn": {
          "type": "object",
          "required": ["position", "rotation"],
          "properties": {
            "position": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "rotation": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "entryAllowed": { "type": "boolean" },
        "gravity": { "type": "boolean" },
        "locomotion": {
          "type": "string",
          "enum": ["standard", "slow", "stationary", "non-euclidean"]
        },
        "returnAllowed": { "type": "boolean" }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "track": { "type": "string" },
        "loop": { "type": "boolean" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "baseFrequency": { "type": "number" },
        "harmonicProfile": {
          "type": "string",
          "enum": ["cathedral", "labyrinth", "mirror", "void", "memory"]
        }
      }
    },
    "paintings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "image", "frame", "position", "rotation", "metadata"],
        "properties": {
          "id": { "type": "string" },
          "image": { "type": "string" },
          "frame": {
            "type": "string",
            "enum": ["classic_gold", "obsidian_minimal", "travertine_deep", "bronze_monument"]
          },
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "scale": { "type": "number" },
          "metadata": {
            "type": "object",
            "required": ["title", "author", "license", "source"],
            "properties": {
              "title": { "type": "string" },
              "titleRu": { "type": "string" },
              "author": { "type": "string" },
              "license": { "type": "string" },
              "source": { "type": "string" },
              "url": { "type": "string" },
              "inscription": { "type": "string" },
              "inscriptionRu": { "type": "string" }
            }
          },
          "interaction": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["inspect", "observe", "activate", "discover", "portal"]
              },
              "discovery": { "type": "string" },
              "mutatesOnIgnore": { "type": "boolean" }
            }
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "portable", "interactions", "position"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "titleRu": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["item", "monolith", "plinth", "chair", "shadow_anomaly", "reflection_anomaly", "inscription", "sundial"]
          },
          "model": { "type": "string" },
          "portable": { "type": "boolean", "const": false },
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "interactions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["inspect", "look", "touch", "activate", "rotate", "open", "close", "push", "pull", "listen", "read", "observe"]
            }
          },
          "discoveryId": { "type": "string" },
          "minVisitCount": { "type": "integer", "minimum": 1 },
          "castsShadow": { "type": "boolean" },
          "visibleInMirror": { "type": "boolean" },
          "onlyInMirror": { "type": "boolean" }
        }
      }
    },
    "quest": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["observe", "interact", "solve", "choose", "remember", "compare", "discover", "contradict", "listen", "wait", "return", "identity"]
        },
        "question": { "type": "string" },
        "questionRu": { "type": "string" },
        "objective": { "type": "string" },
        "objectiveRu": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "labelRu": { "type": "string" },
              "consequenceFlag": { "type": "string" }
            }
          }
        },
        "completion": {
          "type": "object",
          "required": ["type", "target"],
          "properties": {
            "type": { "type": "string" },
            "target": { "type": "string" }
          }
        }
      }
    },
    "mirror": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "characterState": { "type": "string" },
        "characterStateRu": { "type": "string" },
        "proposition": { "type": "string" },
        "propositionRu": { "type": "string" },
        "appearance": { "type": "string" },
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "choices": {
          "type": "object",
          "required": ["accept", "reject", "return"],
          "properties": {
            "accept": { "type": "object" },
            "reject": { "type": "object" },
            "return": { "type": "object" }
          }
        }
      }
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "destination", "status"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "subtitle": { "type": "string" },
          "subtitleRu": { "type": "string" },
          "symbol": { "type": "string" },
          "destination": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["ready", "planned", "void", "conditional", "disabled"]
          },
          "visibility": {
            "type": "string",
            "enum": ["visible", "hidden", "reflection-only"]
          },
          "type": {
            "type": "string",
            "enum": ["standard", "rabbit-hole", "monumental"]
          },
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "fallback": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["infinity", "fractal", "fog", "darkness", "starfield", "mirror", "unknown"]
              }
            }
          },
          "requirement": {
            "type": "object",
            "required": ["type", "id"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["flag", "identity", "quest", "discovery", "room-state", "visit-count", "choice"]
              },
              "id": { "type": "string" },
              "minValue": { "type": "number" }
            }
          },
          "proposition": {
            "type": "object",
            "properties": {
              "prompt": { "type": "string" },
              "promptRu": { "type": "string" },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "text", "destinationOverride"],
                  "properties": {
                    "id": { "type": "string" },
                    "text": { "type": "string" },
                    "textRu": { "type": "string" },
                    "destinationOverride": { "type": ["string", "null"] },
                    "voidOverride": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
