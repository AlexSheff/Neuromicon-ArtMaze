{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuromicon.artmaze/schema/room.schema.json",
  "title": "Neuromicon Artmaze Room Manifest (Room API v1)",
  "type": "object",
  "required": [
    "apiVersion",
    "entry",
    "allowedHosts",
    "id",
    "identity",
    "audio",
    "quest",
    "doors",
    "mirror",
    "objects",
    "radio"
  ],
  "properties": {
    "apiVersion": { "type": "integer", "const": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "allowedHosts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "id": {
      "type": "string",
      "pattern": "^ROOM_[0-9]{3,4}$"
    },
    "identity": {
      "type": "object",
      "required": ["name", "symbol", "description", "dimension"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nameRu": { "type": "string" },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 6 },
        "description": { "type": "string" },
        "descriptionRu": { "type": "string" },
        "dimension": { "type": "string", "pattern": "^D[0-9]+$" }
      }
    },
    "audio": {
      "type": "object",
      "required": ["track", "loop"],
      "properties": {
        "track": { "type": "string", "minLength": 1 },
        "loop": { "type": "boolean" },
        "baseHz": { "type": "number" }
      }
    },
    "quest": {
      "type": "object",
      "required": ["question", "objective", "completion"],
      "properties": {
        "question": { "type": "string" },
        "questionRu": { "type": "string" },
        "objective": { "type": "string" },
        "objectiveRu": { "type": "string" },
        "completion": {
          "type": "object",
          "required": ["type", "target"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["interact", "observe", "interactReflection", "puzzle"]
            },
            "target": { "type": "string" }
          }
        }
      }
    },
    "doors": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "symbol",
          "label",
          "destination",
          "requirement",
          "visibility",
          "choiceType"
        ],
        "properties": {
          "id": { "type": "string", "enum": ["A", "B", "C", "RH"] },
          "symbol": { "type": "string" },
          "label": { "type": "string" },
          "labelRu": { "type": "string" },
          "destination": { "type": "string", "pattern": "^ROOM_[0-9]{3,4}$" },
          "requirement": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["type", "target"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["interactReflection", "questComplete", "identity", "observeShadow"]
                  },
                  "target": { "type": "string" }
                }
              }
            ]
          },
          "visibility": { "type": "string", "enum": ["visible", "hidden"] },
          "choiceType": {
            "type": "string",
            "enum": ["identity-accept", "identity-reject", "free", "rabbit-hole"]
          }
        }
      }
    },
    "mirror": {
      "type": "object",
      "required": ["characterState", "appearance", "choices"],
      "properties": {
        "characterState": { "type": "string" },
        "characterStateRu": { "type": "string" },
        "appearance": { "type": "string" },
        "choices": {
          "type": "array",
          "items": { "type": "string", "enum": ["accept", "reject", "back"] }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "portable"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "titleRu": { "type": "string" },
          "type": { "type": "string", "enum": ["item", "busyboard", "monolith", "anomaly"] },
          "model": { "type": "string" },
          "interactions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "portable": { "type": "boolean", "const": false },
          "visibleInMirror": { "type": "boolean" },
          "onlyInMirror": { "type": "boolean" },
          "config": { "type": "object" }
        }
      }
    },
    "radio": {
      "type": "object",
      "required": ["channel"],
      "properties": {
        "channel": { "type": "string" }
      }
    }
  }
}
