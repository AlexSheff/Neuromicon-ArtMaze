{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuromicon.artmaze/schema/world.schema.json",
  "title": "Neuromicon Artmaze World Topology Graph (1149 Rooms)",
  "type": "object",
  "required": ["version", "totalRooms", "organizationAllowlist", "nodes", "edges"],
  "properties": {
    "version": { "type": "string" },
    "totalRooms": { "type": "integer", "const": 1149 },
    "organizationAllowlist": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "symbol",
          "dimension",
          "branch",
          "segment",
          "status",
          "repo",
          "ref",
          "entryHash"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^ROOM_[0-9]{3,4}$" },
          "title": { "type": "string" },
          "titleRu": { "type": "string" },
          "symbol": { "type": "string" },
          "dimension": { "type": "string" },
          "branch": { "type": "string", "enum": ["ascend", "descend"] },
          "segment": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["ready", "planned"] },
          "repo": { "type": "string" },
          "ref": { "type": "string" },
          "entryHash": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "doorId", "choiceType"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "doorId": { "type": "string", "enum": ["A", "B", "C", "RH"] },
          "choiceType": {
            "type": "string",
            "enum": ["identity-accept", "identity-reject", "free", "rabbit-hole"]
          }
        }
      }
    }
  }
}
